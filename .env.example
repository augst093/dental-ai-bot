# ==============================================================================
# КОНФИГУРАЦИЯ TELEGRAM БОТА КЛИНИКИ DENTALUX TASHKENT (AI + REMINDERS)
# ==============================================================================

# Токен вашего Telegram бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# ID закрытой группы или личного чата администраторов для мгновенных уведомлений
ADMIN_CHAT_ID=-1001234567890

# ==============================================================================
# AI ЯДРО: ОФИЦИАЛЬНЫЙ DEEPSEEK API (ОСНОВНОЙ ПРОВАЙДЕР)
# ==============================================================================
# Получить ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==============================================================================
# РЕЗЕРВНЫЙ AI ПРОВАЙДЕР: OPENAI API (ОПЦИОНАЛЬНО)
# ==============================================================================
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# БАЗА ДАННЫХ И СИСТЕМНЫЕ НАСТРОЙКИ
# ==============================================================================
# Путь к локальной SQLite базе данных (создается автоматически)
DATABASE_PATH=data/dental_bot.db

# Часовой пояс клиники (Ташкент: UTC+5)
TIMEZONE=Asia/Tashkent

# Ограничение контекста диалога для быстрой генерации ответа LLM
HISTORY_LIMIT=6

# URL развернутого Telegram Mini App
MINIAPP_URL=https://dentalminiapp.vercel.app

# ==============================================================================
# GOOGLE SHEETS ИНТЕГРАЦИЯ (ОПЦИОНАЛЬНО)
# ==============================================================================
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_NAME=Dental Leads Tashkent
