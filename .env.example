# ==============================================================================
# КОНФИГУРАЦИЯ TELEGRAM БОТА КЛИНИКИ DENTALUX TASHKENT
# ==============================================================================

# Токен вашего Telegram бота (от @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# ID вашей закрытой группы администраторов для заявок (начинается с минуса: -100...)
ADMIN_CHAT_ID=-1001234567890

# ==============================================================================
# AI ЯДРО: ОФИЦИАЛЬНЫЙ DEEPSEEK API (РЕКОМЕНДУЕТСЯ)
# ==============================================================================
# Получить ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==============================================================================
# РЕЗЕРВНЫЙ ПРОВАЙДЕР: OPENAI API (ОПЦИОНАЛЬНО)
# ==============================================================================
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# БАЗА ДАННЫХ И СИСТЕМНЫЕ НАСТРОЙКИ
# ==============================================================================
DATABASE_PATH=data/dental_bot.db
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_NAME=Dental Leads Tashkent
TIMEZONE=Asia/Tashkent
HISTORY_LIMIT=12
